# Wi-Vi Sentinel — local configuration
# Copy this file to .env and edit as needed.
# .env is gitignored; .env.example is the committed reference.

# ── Flask API server ──────────────────────────────────────────────────────────
FLASK_PORT=5555

# ── Vite dev server ───────────────────────────────────────────────────────────
VITE_PORT=3000

# ── CSI source ────────────────────────────────────────────────────────────────
# "simulated" (default), "esp32" (ESP32 via USB serial), or "nexmon" (legacy)
CSI_SOURCE=simulated

# ── ESP32 / Serial ────────────────────────────────────────────────────────────
# Serial port for ESP32 connected via USB
# On Pi: /dev/ttyUSB0 (most common) or /dev/ttyACM0
# On Mac: /dev/cu.usbserial-110 (check with: ls /dev/cu.usbserial-*)
ESP32_SERIAL_PORT=/dev/ttyUSB0
ESP32_BAUD_RATE=921600

# ── Nexmon / UDP (legacy — not used with ESP32) ─────────────────────────────
# CSI_UDP_PORT=5500

# ── Device probe sniffing ─────────────────────────────────────────────────────
# Monitor-mode interface to sniff 802.11 probe requests.
# Leave blank to disable probe sniffing (mDNS still runs automatically).
#
# Common values:
#   PROBE_IFACE=          ← disabled (default)
#   PROBE_IFACE=mon0      ← Nexmon monitor interface
#   PROBE_IFACE=wlan0mon  ← alternative naming (check with: iw dev)
PROBE_IFACE=

# ── RuView (WiFi DensePose pose estimation) ───────────────────────────────────
# RuView adds 17-keypoint pose estimation + vital signs using WiFi CSI.
# start.sh automatically launches a RuView Docker container if Docker is available.
#
# RUVIEW_PORT: host port for RuView (avoid 3000 which Vite uses in dev mode).
# RUVIEW_URL:  URL Flask uses to proxy /api/ruview/* requests.
#              Change hostname if running RuView on a separate machine.
#
# To disable RuView entirely: set RUVIEW_ENABLED=false
RUVIEW_PORT=3100
RUVIEW_URL=http://localhost:3100
RUVIEW_ENABLED=true
